# =============================================================================
# .env — Configurazione LoRa APRS iGate
# Copia questo file in /usr/local/lib/lora-aprs/.env e modifica i valori
# Dopo ogni modifica esegui: ./update-config.sh
# =============================================================================

# iGate
CALLSIGN=IZ5XXX-10
IGATE_IP=192.168.1.10
IGATE_REBOOT_PW=raspberry

# Telegram notifiche pacchetti
BOT_TOKEN_NOTIFY=YOUR_NOTIFY_BOT_TOKEN
CHAT_ID_NOTIFY=YOUR_NOTIFY_CHAT_ID

# Telegram alert sistema
BOT_TOKEN_ALERT=YOUR_ALERT_BOT_TOKEN
CHAT_ID_ALERT=YOUR_ALERT_CHAT_ID

# Posizione iGate
LATITUDE=43.68047
LONGITUDE=11.52987
LOCATION=La tua città

# Storage
HAS_SSD=True
SSD_MOUNT=/mnt/ssd

# Hardware opzionale
HAS_OLED=True
OLED_I2C_ADDR=0x3C

# Database
DB_RETENTION_DAYS=30

# Timezone
TIMEZONE=Europe/Rome
